# ─── Database (required) ────────────────────────────────────────────
# PostgreSQL connection string. On the PaaS, copy it from the managed database page.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hinesp"
# Separate database used only by `npm test`. It is wiped on every test run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hinesp_test"

# ─── Auth (required) ────────────────────────────────────────────────
# Random 32+ byte secret for signing sessions. Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the panel (no trailing slash). Needed behind the PaaS proxy.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Encryption (required) ──────────────────────────────────────────
# 32-byte key, base64. Encrypts product tokens, webhook secret and AI key in the DB.
# Generate: openssl rand -base64 32   — never change it after first use.
ENCRYPTION_KEY="change-me-base64-32-bytes"

# ─── Cron (required) ────────────────────────────────────────────────
# Cron jobs must send this value in the `x-cron-secret` header.
CRON_SECRET="change-me"

# ─── File storage ───────────────────────────────────────────────────
# "local" (files under LOCAL_UPLOAD_DIR; needs a persistent disk) or "s3".
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
# Only when STORAGE_DRIVER=s3 (any S3-compatible service, e.g. Liara object storage)
S3_ENDPOINT=""
S3_REGION="default"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─── Seed (used once by `npm run db:seed`) ──────────────────────────
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-now"
# Password for the sample users created per department. Leave empty to skip sample users.
SEED_SAMPLE_PASSWORD="Hinesp@1234"
